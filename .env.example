# Copy to .env.local for development. In deployed environments set these in the
# Vercel project settings. lib/env.ts validates the required ones at module
# load, so a missing value fails loudly and by name instead of surfacing as
# "supabaseUrl is required" on every request.

# --- Required -------------------------------------------------------------

# Supabase project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable ("anon") key. Safe to expose to the browser — RLS is the
# security boundary. Never put the service-role key in a NEXT_PUBLIC_ var.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Optional -------------------------------------------------------------

# Absolute origin used for canonical URLs, Open Graph tags, robots.txt and the
# sitemap. Falls back to https://www.nookph.app (the apex does not resolve). If
# it is wrong, every canonical and every sitemap entry points at the wrong
# host, which is an SEO failure that is easy to miss.
NEXT_PUBLIC_SITE_URL=

# PostHog product analytics, project "Nook" (473868, US cloud) — shared with
# nook-mobile and study-hub; every web event is stamped app=nook-webapp. The
# project token is public (phc_…, write-only). Unset = no analytics. Set it for
# the Production environment only, so preview deployments don't report.
# Events go through the /nk rewrite in next.config.ts, not straight to PostHog.
NEXT_PUBLIC_POSTHOG_KEY=
# Region of the project, used for toolbar/app links. Default US.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Localhost never reports unless this is "true"; forced local runs get a
# distinct id starting with dev-test- so they can be filtered out.
NEXT_PUBLIC_POSTHOG_FORCE=
